# Only reusable configuration source files are public. Every instance directory,
# private store, selection, runtime file, backup and compiled binary is excluded.
/configs/*
!/configs/cbc-clipboard-image-run.sh
!/configs/cbc-clipboard-image.c
!/configs/cbc-clipboard-image.nginx.conf
!/configs/chromium-params.sh
!/configs/chromium-policy.json
!/configs/novnc-clipboard-focus.sh
!/configs/novnc-clipboard-image.sh
!/configs/novnc-hidpi.sh
!/configs/novnc-ime.js
!/configs/novnc-ime.sh
!/configs/novnc-keyboard-shortcuts.sh
!/configs/novnc-native-cursor.sh
!/configs/proxy.example.json
!/configs/seccomp-chromium.json
!/configs/seccomp-default.json
!/configs/selection.example.json

